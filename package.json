{
  "name": "dsh-tinyfish",
  "version": "0.2.0",
  "description": "TinyFish-backed search and fetch providers for the DeepSeek Harness web capability seam (ctx.web) — $0 SERP and page extraction, direct or via Monid.",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "monid",
    "scraping",
    "search",
    "tinyfish",
    "web-fetch",
    "web-search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viztor/dsh-tinyfish.git"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs",
      "default": "./lib/index.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "ci": "vp check && vp test && node scripts/check.mjs",
    "clean": "rm -rf lib",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "vp pack",
    "prepublishOnly": "pnpm run release:gate",
    "release:gate": "pnpm run build && pnpm run ci",
    "test": "vp test",
    "test:live": "DSH_TINYFISH_LIVE=1 vp test --config vite.live.config.ts --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-web": "0.2.0-rc.1",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.1",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-web": "^0.2.0-rc.1"
  },
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@12.6.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
